# Porta do servidor (default: 3000)
PORT=3000

# Chave de API para proteger o PROXY (clientes OpenAI) — opcional
API_KEY=sua-chave-secreta-aqui

# Senha do painel /admin (troque quando quiser)
ADMIN_PASSWORD=123456

# Conta inicial do DeepSeek (migrada para o stack de contas no primeiro boot)
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

# Configurações Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Limite de contexto em tokens (1M para projetos gigantes — ~3.5M chars)
CONTEXT_TOKENS=1000000

# Espera do auto-login em ms (para desafios humanos, se aparecerem)
DEEPSEEK_AUTOLOGIN_WAIT_MS=90000
